{
	"name": "Material for MkDocs",
	"image": "mcr.microsoft.com/devcontainers/python:3.12",
	"customizations": {
		"vscode": {
			"extensions": [
				"davidanson.vscode-markdownlint"
			]
		}
	},
	"forwardPorts": [
		8000
	],
	"postCreateCommand": "pip install -r requirements.txt",
	"remoteUser": "vscode"
}
